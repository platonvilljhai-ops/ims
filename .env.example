# Database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=edushelf
DB_PASSWORD=change-me
DB_NAME=edushelf_db

# Optional: use a MySQL connection URL instead of the DB_* settings.
# MYSQL_URL=mysql://user:password@database-host:3306/edushelf_db

# Flask session signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-long-random-string

# Optional runtime settings
FLASK_DEBUG=0
PORT=5000
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
SESSION_COOKIE_SECURE=false
HTTP_PORT=80
